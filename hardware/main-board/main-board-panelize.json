// KiKit panelization for the Printalyzer Enlarging Timer Main Board
// This produces a 202x222mm sized panel, containing 2 boards.
// Edge rails are on the sides, and tooling holes are designed for 2.0mm pins.
{
    "layout": {
        "type": "grid",
        "rows": 2,
        "cols": 1,
        "hspace": "2.0mm",
        "vspace": "2.0mm",
        "rotation": "180deg",
        "alternation": "rows",
        "renamenet": "Board_{n}-{orig}",
        "renameref": "{orig}"
    },
    "source": {
        "type": "auto",
        "tolerance": "5mm"
    },
    "tabs": {
        "type": "annotation"
    },
    "cuts": {
        "type": "vcuts",
    },
    "framing": {
        "type": "railslr",
        "width": "5mm",
        "space": "2mm"
    },
    "tooling": {
        "type": "4hole",
        "hoffset": "2.5mm",
        "voffset": "5mm",
        "size": "2.05mm",
        "soldermaskmargin": "0.15mm"
    },
    "fiducials": {
        "type": "3fid",
        "hoffset": "2.5mm",
        "voffset": "10mm",
        "coppersize": "1mm",
        "opening": "2mm"
    },
    "text": {
        "type": "simple",
        "text": "{boardTitle} Panel",
        "anchor": "ml",
        "orientation": "90deg",
        "hoffset": "2.5mm",
        "hjustify": "center"
    },
    "post": {
        "millradius": "1mm",
        "origin": "bl",
        "script": "tools/kikit-post.py",
        "scriptarg": "side"
    }
}
